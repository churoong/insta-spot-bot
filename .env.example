# ===== 한국관광공사 TourAPI (공공데이터포털 data.go.kr에서 무료 발급) =====
# "한국관광공사_국문 관광정보 서비스" 활용신청 → 일반 인증키(Decoding) 값
TOUR_API_KEY=

# ===== 백년가게 공공데이터 (선택 — 인증맛집 목록 자동 동기화) =====
# data.go.kr "전국 백년가게 지정리스트" 활용신청 후 일반 인증키. 없으면 TOUR_API_KEY로 시도.
HYS_API_KEY=

# ===== 카카오 로컬 API (선택 — DM 길찾기 링크 + 후보 발굴 확대) =====
# developers.kakao.com 앱 → REST API 키. 없으면 관련 기능만 자동 생략.
KAKAO_REST_KEY=

# ===== Pexels 스톡 사진 API (선택 — 감성 테마 게시물) =====
# pexels.com/api 무료 발급. 없으면 테마 게시물만 자동 생략.
PEXELS_KEY=

# ===== Meta (Instagram Graph API) =====
# developers.facebook.com 앱 생성 후 발급. README의 셋업 가이드 참고.
IG_USER_ID=                # 인스타그램 비즈니스 계정의 IG User ID (숫자)
IG_ACCESS_TOKEN=           # 장기(60일) Page Access Token
META_APP_SECRET=           # 웹훅 서명 검증용 앱 시크릿
WEBHOOK_VERIFY_TOKEN=      # 웹훅 등록 시 쓸 임의 문자열 (직접 정하면 됨)

# ===== Gemini API (캡션/해시태그 생성 — 무료 등급, 카드 불필요) =====
# aistudio.google.com → Get API key. 비워두면 내장 템플릿으로 생성(완전 무료).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ===== Turso (DB) =====
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ===== 봇 설정 =====
CRON_SECRET=               # 크론 엔드포인트 보호용 임의 문자열
DM_KEYWORD=어디야           # 이 단어가 댓글에 포함되면 DM 발송
POSTS_PER_DAY_LIMIT=24     # 하루 최대 발행 수 (Graph API 한도는 50/일)
